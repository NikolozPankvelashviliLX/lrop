<mvc:View controllerName="npproj1.controller.ObjectPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap">

    <uxap:ObjectPageLayout id="objectPageLayout" upperCaseAnchorBar="false">

        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>

                <uxap:breadcrumbs>
                    <Breadcrumbs>
                        <Link text="{i18n>listReport}" press=".onNavBack" />
                        <Link text="{Name}" />
                    </Breadcrumbs>
                </uxap:breadcrumbs>

                <uxap:heading>
                    <Title text="{Name}" level="H2" />
                </uxap:heading>

                <uxap:actions>
                    <Button text="{i18n>delete}" type="Transparent" press=".onDeleteStore" />
                </uxap:actions>

            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <ObjectAttribute title="{i18n>address}" text="{Address}" />
        </uxap:headerContent>

        <uxap:sections>

            <uxap:ObjectPageSection title="{i18n>basicInfo}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <l:HorizontalLayout>
                                <f:SimpleForm layout="ResponsiveGridLayout">
                                    <Label text="{i18n>name}" labelFor="basicInfoName" />
                                    <Text id="basicInfoName" text="{Name}" />

                                    <Label text="{i18n>floorArea}" labelFor="basicInfoFloorArea" />
                                    <Text id="basicInfoFloorArea" text="{FloorArea} ft" />

                                </f:SimpleForm>
                                <f:SimpleForm layout="ResponsiveGridLayout">
                                    <Label text="{i18n>phone}" labelFor="basicInfoPhone" />
                                    <Text id="basicInfoPhone" text="{PhoneNumber}" />

                                    <Label text="{i18n>establishedDate}" labelFor="basicInfoEstablishedDate" />
                                    <Text 
                                    id="basicInfoEstablishedDate" 
                                    text="{
                                        path: 'Established',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: { style: 'long' }
                                        }" 
                                    />
                                </f:SimpleForm>
                            </l:HorizontalLayout>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="{i18n>products}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <core:Fragment fragmentName="npproj1.view.ProductsTable" type="XML" />
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>

    </uxap:ObjectPageLayout>
</mvc:View>
