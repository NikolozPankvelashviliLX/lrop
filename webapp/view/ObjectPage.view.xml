<mvc:View controllerName="npproj1.controller.ObjectPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:uxap="sap.uxap">

    <uxap:ObjectPageLayout id="objectPageLayout" showAnchorBar="true">

        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:heading>
                    <Title text="{Name}" level="H2"/>
                </uxap:heading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <ObjectAttribute title="Address" text="{Address}" />
        </uxap:headerContent>

        <uxap:sections>

            <uxap:ObjectPageSection title="Basic Info">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <l:HorizontalLayout>
                                <f:SimpleForm layout="ResponsiveGridLayout">
                                    <Label text="Store Name" />
                                    <Text text="{Name}" />

                                    <Label text="Floor Area" />
                                    <Text text="{FloorArea} ft" />

                                </f:SimpleForm>
                                <f:SimpleForm layout="ResponsiveGridLayout">
                                    <Label text="Phone" />
                                    <Text text="{PhoneNumber}" />

                                    <Label text="Established Date" />
                                    <Text text="{
                                    path: 'Established',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { style: 'long' }
                                }"/>
                                </f:SimpleForm>
                            </l:HorizontalLayout>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="Products">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="productsTable" items="{Products}" class="sapUiResponsiveMargin" width="auto">

                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Products List"/>
                                        <ToolbarSpacer />
                                        <SearchField id="productsSearchField" width="auto"/>
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column>
                                        <Text text="Product Name"/>
                                    </Column>
                                    <Column>
                                        <Text text="Specs"></Text>
                                    </Column>
                                    <Column>
                                        <Text text="Supplier Info"></Text>
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Price"/>
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Rating"/>
                                    </Column>
                                    <Column>
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectAttribute text="{Name}"/>
                                            <Text text="{Specs}" maxLines="1" wrapping="false"/>
                                            <Text text="{SupplierInfo}" maxLines="1" wrapping="false"/>
                                            <ObjectNumber number="{path: 'Price_amount', formatter: '.formatter.formatCurrency'}" unit="{Price_currency}"/>
                                            <RatingIndicator value="{Rating}" editable="false" iconSize="1rem"/>
                                            <HBox justifyContent="End" >
                                                <Button type="Transparent" icon="sap-icon://edit" press=".onEditPress" class="sapUiTinyMarginEnd"/>
                                                <Button type="Transparent" icon="sap-icon://delete" press=".onDeletePress"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>

        <uxap:footer>
            <OverflowToolbar/>
        </uxap:footer>

    </uxap:ObjectPageLayout>
</mvc:View>