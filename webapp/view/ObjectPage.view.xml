<mvc:View controllerName="npproj1.controller.ObjectPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:uxap="sap.uxap">

    <uxap:ObjectPageLayout id="objectPageLayout">

        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>

                <uxap:breadcrumbs>
                    <Breadcrumbs>
                        <Link text="{i18n>listReport}" press=".onNavBack" />
                        <Link text="{Name}" />
                    </Breadcrumbs>
                </uxap:breadcrumbs>

                <uxap:heading>
                    <Title text="{Name}" level="H2" />
                </uxap:heading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <ObjectAttribute title="{i18n>address}" text="{Address}" />
        </uxap:headerContent>

        <uxap:sections>

            <uxap:ObjectPageSection title="{i18n>basicInfo}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <l:HorizontalLayout>
                                <f:SimpleForm layout="ResponsiveGridLayout">
                                    <Label text="{i18n>name}" labelFor="basicInfoName" />
                                    <Text id="basicInfoName" text="{Name}" />

                                    <Label text="{i18n>floorArea}" labelFor="basicInfoFloorArea" />
                                    <Text id="basicInfoFloorArea" text="{FloorArea} ft" />

                                </f:SimpleForm>
                                <f:SimpleForm layout="ResponsiveGridLayout">
                                    <Label text="{i18n>phone}" labelFor="basicInfoPhone" />
                                    <Text id="basicInfoPhone" text="{PhoneNumber}" />

                                    <Label text="{i18n>establishedDate}" labelFor="basicInfoEstablishedDate" />
                                    <Text id="basicInfoEstablishedDate" text="{
                                    path: 'Established',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { style: 'long' }
                                    }" />
                                </f:SimpleForm>
                            </l:HorizontalLayout>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="{i18n>products}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="productsTable" items="{Products}" class="sapUiResponsiveMargin" width="auto">

                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="{i18n>productsList}" />
                                        <ToolbarSpacer />
                                        <SearchField id="productsSearchField" width="auto" search=".onProductSearch" />
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column>
                                        <Text text="{i18n>name}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>specs}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>supplierInfo}" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="{i18n>price}" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="{i18n>rating}" />
                                    </Column>
                                    <Column>
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectAttribute text="{Name}" />
                                            <Text text="{Specs}" maxLines="1" wrapping="false" />
                                            <Text text="{SupplierInfo}" maxLines="1" wrapping="false" />
                                            <ObjectNumber number="{path: 'Price_amount', formatter: '.formatter.formatCurrency'}" unit="{Price_currency}" />
                                            <RatingIndicator value="{Rating}" editable="false" iconSize="1rem" />
                                            <HBox justifyContent="End">
                                                <Button type="Transparent" icon="sap-icon://edit" press=".onEditPress" class="sapUiTinyMarginEnd" />
                                                <Button type="Transparent" icon="sap-icon://delete" press=".onDeletePress" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>

    </uxap:ObjectPageLayout>
</mvc:View>
