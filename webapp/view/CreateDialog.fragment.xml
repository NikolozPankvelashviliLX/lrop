<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog
        id="createDialog"
        title="{i18n>createNewStore}"
        contentWidth="25rem">
        <content>
            <f:SimpleForm
                editable="true">
                
                <Label text="{i18n>name}" required="true" labelFor="nameInput" />
                <Input id="nameInput" value="{newStore>/Name}" required="true" />
                
                <Label text="{i18n>floorAreaWithUnit}" required="true" />
                <Input id="floorAreaInput"
                       value="{newStore>/FloorArea}"
                       type="Number"
                       required="true"
                       />
                
                <Label text="{i18n>establishedDate}" required="true" />
                <DatePicker id="dateInput"
                            value="{newStore>/Established}"
                            valueFormat="yyyy-MM-ddTHH:mm:ss"
                            displayFormat="long"
                            required="true"
                            />
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="{i18n>save}"
                type="Emphasized"
                press=".onSaveCreate" />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>cancel}"
                press=".onCancelCreate" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>