<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog
        id="editProductDialog"
        title="Edit Product"
        contentWidth="25rem">
        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout">
                
                <Label text="Product Name" required="true"/>
                <Input id="nameEditInput" value="{Name}"/>
                
                <Label text="Specs" />
                <TextArea rows="4" id="specsEditInput" value="{Specs}"/>

                <Label text="Supplier Info" />
                <TextArea rows="4" id="supplierEditInput" value="{SupplierInfo}"/>
                
                <Label text="Price" />
                <Input value="{Price_amount}" />

                <Label text="Rating" />
                <RatingIndicator 
                    id="ratingEditInput"
                    value="{Rating}"
                    editable="true"/>

            </f:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveEdit"/>
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelEdit"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>