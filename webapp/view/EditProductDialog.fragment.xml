<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog
        id="editProductDialog"
        title="{i18n>editProduct}"
        contentWidth="25rem">
        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout">
                
                <Label text="{i18n>name}" required="true"/>
                <Input id="nameEditInput" value="{Name}"/>
                
                <Label text="{i18n>specs}" />
                <TextArea rows="4" id="specsEditInput" value="{Specs}"/>

                <Label text="{i18n>supplierInfo}" />
                <TextArea rows="4" id="supplierEditInput" value="{SupplierInfo}"/>
                
                <Label text="{i18n>price}" />
                <Input value="{Price_amount}" />

                <Label text="{i18n>rating}" />
                <RatingIndicator 
                    id="ratingEditInput"
                    value="{Rating}"
                    editable="true"/>

            </f:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="{i18n>save}"
                type="Emphasized"
                press=".onSaveEdit"/>
        </beginButton>
        <endButton>
            <Button
                text="{i18n>cancel}"
                press=".onCancelEdit"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>