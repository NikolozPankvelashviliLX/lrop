<mvc:View controllerName="npproj1.controller.ListReport"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <f:DynamicPage id="ListReportDynamicPageId" >

        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>listReport}" />
                </f:heading>

                <f:snappedContent>
                    <Text text="{= ${appState>/filterMessage} ? ${appState>/filterMessage} : ${i18n>noActiveFilters}}" />
                </f:snappedContent>
                
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <fb:FilterBar 
                    id="filterbar" 
                    persistencyKey="myPersKey" 
                    useToolbar="false" 
                    search=".onFilterBarSearch" 
                    basicSearch="searchField">

                    <fb:dependents>
                        <SearchField id="searchField" width="100%" placeholder="{i18n>search}" search=".onSearchFieldExecute" />
                    </fb:dependents>

                    <fb:filterGroupItems>
                        <fb:FilterGroupItem name="DateFilter" label="{i18n>date}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <DatePicker id="datePicker" />
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>

                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table id="storesTable" mode="MultiSelect" items="{/Stores}" class="sapUiResponsiveMargin" width="auto" selectionChange=".onSelectionChange">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>storeList}" />
                        <ToolbarSpacer />
                        <Button text="{i18n>sort}" type="Transparent" icon="sap-icon://sort" press=".onSort" />
                        <Button text="{i18n>create}" type="Transparent" icon="sap-icon://add" press=".onCreate" />
                        <Button text="{i18n>delete}" type="Transparent" icon="sap-icon://delete" press=".onDelete" enabled="{appState>/deleteEnabled}" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="{i18n>name}" />
                        <customData>
                            <core:CustomData key="path" value="Name" />
                        </customData>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End">
                        <Text text="{i18n>floorArea}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End">
                        <Text text="{i18n>date}" />
                        <customData>
                            <core:CustomData key="path" value="Established" />
                        </customData>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onListItemPress">
                        <cells>
                            <ObjectIdentifier title="{StoreName}" text="{Name}" />
                            <ObjectNumber number="{path: 'FloorArea', formatter: '.formatter.formatFloorArea'}" unit="ft" state="{path: 'FloorArea', formatter: '.formatter.formatAreaState'}" />
                            <Text text="{
                                    path: 'Established',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { style: 'long' }
                                }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>

    </f:DynamicPage>
</mvc:View>